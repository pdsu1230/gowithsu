{
  "name": "dangu-tour-booking",
  "version": "1.0.0",
  "description": "Tour booking web app for fixed mountain tours",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "pg:test": "node -e \"require('./database/postgres').testConnection().then((r)=>{console.log('Postgres connected at', r.now); process.exit(0);}).catch((e)=>{console.error(e.message); process.exit(1);})\"",
    "migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-postgres.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/tailwind.css --watch"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "better-sqlite3": "^12.9.0",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2"
  }
}
